{
  "config": {
    "workers": {
      "worker_counts": 4
    },
    "api": {
      "enabled": true,
      "dash_db_path": "run-data/news/dash.db"
    },
    "metrics": {
      "enabled": false
    },
    "http_client": {
      "allowed_domains": [
        "localhost"
      ],
      "request_delay": "100ms"
    },
    "shutdown_timeout": "30s",
    "countries_path": "extractors/testdata/countries.json",
    "companies_path": "extractors/testdata/companies.json"
  },
  "resources": [
    {
      "name": "requests",
      "type": "crawl_queue",
      "parameters": {
        "path": "run-data/news/crawl",
        "crawl_id": "news",
        "max_attempts": 3,
        "recrawl_after": "10m"
      }
    },
    {
      "name": "fetched",
      "type": "file_queue",
      "parameters": {
        "name": "fetched",
        "path": "run-data/news/fetched",
        "dlq_path": "run-data/news/fetched-dlq",
        "max_poll_delay_ms": 20,
        "max_attempts": 3,
        "reset": true
      }
    },
    {
      "name": "analyzed",
      "type": "file_queue",
      "parameters": {
        "name": "analyzed",
        "path": "run-data/news/analyzed",
        "dlq_path": "run-data/news/analyzed-dlq",
        "max_poll_delay_ms": 20,
        "max_attempts": 3,
        "reset": true
      }
    },
    {
      "name": "results",
      "type": "file_queue",
      "parameters": {
        "name": "results",
        "path": "run-data/news/results",
        "dlq_path": "run-data/news/results-dlq",
        "max_poll_delay_ms": 20,
        "max_attempts": 3,
        "reset": true
      }
    },
    {
      "name": "objects",
      "type": "filesystem_object_store",
      "parameters": {
        "path": "run-data/news/objects"
      }
    },
    {
      "name": "urls",
      "type": "multi_host_map",
      "parameters": {
        "base_path": "run-data/news/urls"
      }
    },
    {
      "name": "transformer_queue",
      "type": "file_queue",
      "parameters": {
        "name": "transformer_queue",
        "path": "run-data/news/transformer_queue",
        "dlq_path": "run-data/news/transformer_queue-dlq",
        "max_poll_delay_ms": 20,
        "max_attempts": 3,
        "reset": true
      }
    }
  ],
  "workers": [
    {
      "name": "seeds",
      "type": "rss_feed_publisher",
      "manager": "job",
      "interval": "10m",
      "outbox": "requests",
      "parameters": {
        "uris": [
          "http://localhost:8088/feed.xml"
        ]
      }
    },
    {
      "name": "fetch",
      "type": "http_fetcher",
      "inbox": "requests",
      "outbox": "fetched",
      "parameters": {
        "object_store": "objects"
      }
    },
    {
      "name": "extract",
      "type": "composite_extractor",
      "inbox": "fetched",
      "outbox": "analyzed",
      "parameters": {
        "object_store": "objects",
        "transformer_queue": "transformer_queue",
        "enabled": [
          "url",
          "text",
          "title",
          "language",
          "country",
          "company_name",
          "sentiment"
        ]
      }
    },
    {
      "name": "news",
      "type": "news_accumulator",
      "inbox": "analyzed",
      "outbox": "requests",
      "parameters": {
        "news_queue": "results",
        "max_depth": 1
      }
    },
    {
      "name": "save",
      "type": "jsonl_sink",
      "inbox": "results",
      "count": 1,
      "parameters": {
        "path": "run-data/news/results.jsonl"
      }
    },
    {
      "name": "index",
      "type": "transformer",
      "inbox": "transformer_queue",
      "count": 1,
      "parameters": {
        "enabled": [
          "composite"
        ],
        "search_addresses": [
          "http://localhost:9200"
        ]
      }
    }
  ]
}
