# Keep source code and required build/dependency metadata only.
*
!*/
!**/*.go
!**/*.js
!**/*.jsx
!**/*.mjs
!**/*.ts
!**/*.tsx
!**/*.css
!**/*.html
!.gitignore
!go.mod
!go.sum
!Makefile
!Dockerfile
!web/start
!web/package.json
!web/package-lock.json
!web/src/views/page/fetchOptions.json
!web2/package.json
!web2/package-lock.json
!web2/tsconfig.json

# Local data, private configuration, generated artifacts, and documentation.
.codex-attachments/
**/node_modules/
/build/
/run-data/
/data/
/docs/
/.github/
/web/build/
/web/public/index.html
**/.env*
**/*.tar*
**/*.zip
**/*.db*
**/*.log
**/*.bak
**/TODO*
**/README*

# Tests, fixtures, experiments, and validation reports stay out of Git.
**/*_test.go
**/*.test.*
**/*.spec.*
**/testSetup.*
**/playwright.config.*
**/test/
**/tests/
**/testdata/
**/testutil/
**/__tests__/
**/e2e/
