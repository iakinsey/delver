# Application source, documentation, and required build/dependency metadata.
*
!*/
!**/*.go
!**/*.js
!**/*.jsx
!**/*.mjs
!**/*.ts
!**/*.tsx
!**/*.css
!**/*.html
!.gitignore
!go.mod
!go.sum
!Makefile
!Dockerfile
!web/start
!web/package.json
!web/package-lock.json
!web/src/views/page/fetchOptions.json

# Local data, private configuration, and generated artifacts.
.codex-attachments/
**/node_modules/
/build/
/run-data/
/data/
/.github/
/web/build/
/web/public/index.html
**/.env*
**/*.tar*
**/*.zip
**/*.db*
**/*.log
**/*.bak
**/TODO*

# Runnable tests and synthetic fixtures.
!**/*_test.go
!**/*.test.*
!**/*.spec.*
!**/testSetup.*
!**/playwright.config.*
!**/testdata/**
!**/fixtures/**
!/data/
!/data/test/
!/data/test/**
!examples/site/**
!examples/workspace-fixture/**
!examples/dashboard-fixture/**
/web/test-results/
/web/playwright-report/
/validation-results/

# Keep project documentation; exclude obsolete frontend and operation artifacts.
!**/README.md
!docs/**/*.md
/web2/
/CRAWLER_OPERATIONS_PLAN.md

!tests/inventory.json
!tests/ui-coverage.json

# Generated/private artifacts remain excluded inside test directories too.
**/node_modules/
**/*.db*
**/*.log
**/*.zip
**/*.tar*
**/.env*
/web/test-results/
/web/playwright-report/

# Runnable standalone validation scripts.
!scripts/*.py
**/__pycache__/
